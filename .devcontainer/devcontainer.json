{
  "name": "Quản lý kho thông minh",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [5141],
  "portsAttributes": {
    "5141": { "label": "Ứng dụng", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "dotnet build src/QuanLyKho.Web",
  "postStartCommand": "nohup dotnet run --no-build --project src/QuanLyKho.Web --launch-profile http > /tmp/quanlykho.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csharp"]
    }
  }
}
