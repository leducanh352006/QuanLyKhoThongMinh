{
  "name": "Quản lý kho thông minh",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [5141],
  "portsAttributes": {
    "5141": { "label": "Ứng dụng", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "dotnet build src/QuanLyKho.Web",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postStartCommand": "bash .devcontainer/chay-ung-dung.sh",
  "postAttachCommand": "bash .devcontainer/chay-ung-dung.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csharp"]
    }
  }
}
