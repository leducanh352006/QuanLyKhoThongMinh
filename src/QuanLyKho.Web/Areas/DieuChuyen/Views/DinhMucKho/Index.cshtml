@model IReadOnlyList<QuanLyKho.Web.Areas.DieuChuyen.Services.DinhMucKhoDong>

<header class="trang-dau d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h1>Định mức kho</h1>
        <p class="mota">Tồn tối thiểu và số ngày an toàn của từng biến thể tại từng kho — tham số đầu vào cho gợi ý G3.</p>
    </div>
    <a class="btn btn-primary" asp-action="Them">Thêm định mức kho</a>
</header>

@if (TempData["ThongBao"] is string tb) { <div class="alert alert-success" role="status">@tb</div> }
@if (TempData["Loi"] is string loi) { <div class="alert alert-danger" role="alert">@loi</div> }

<div class="bang-cuon">
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Kho</th>
                <th scope="col">Biến thể</th>
                <th scope="col" class="text-end">Tồn tối thiểu (m)</th>
                <th scope="col" class="text-end">Số ngày an toàn (N)</th>
                <th scope="col"><span class="visually-hidden">Thao tác</span></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted">Chưa có định mức kho nào.</td></tr>
            }
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.TenKho</td>
                    <td>@d.TenBienThe</td>
                    <td class="text-end">@d.TonToiThieu</td>
                    <td class="text-end">@d.NgayAnToan</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Sua" asp-route-maKho="@d.MaKho" asp-route-maBT="@d.MaBT">Sửa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
