@using QuanLyKho.Web.Areas.DieuChuyen.Models
@using QuanLyKho.Web.Contracts
@model List<PhieuChuyen>
@inject IPhanQuyenService PhanQuyen
@{
    ViewData["Title"] = "Phiếu chuyển kho";
    var q = (string?)ViewBag.Q;
    var tuNgay = (DateOnly?)ViewBag.TuNgay;
    var denNgay = (DateOnly?)ViewBag.DenNgay;
    var trangThai = (string?)ViewBag.TrangThai;
    var dangTrenDuong = (int)ViewBag.DangTrenDuong;
    var soPhieuTrenDuong = (int)ViewBag.SoPhieuTrenDuong;
    var chenhLechCho = (int)ViewBag.ChenhLechCho;
    var duocTao = await PhanQuyen.CoQuyenHienTai(LoaiChungTu.CK, QuyenThaoTac.Them);
    var duocHuy = await PhanQuyen.CoQuyenHienTai(LoaiChungTu.CK, QuyenThaoTac.Xoa);
    string Nhan(string tt) => tt switch
    {
        PhieuChuyen.Nhap => "nhan-chu-y",
        PhieuChuyen.DaDuyet => "nhan-lam",
        PhieuChuyen.DangVanChuyen => "nhan-chu-y",
        PhieuChuyen.NhanMotPhan => "nhan-loi",
        PhieuChuyen.DaNhan => "nhan-tot",
        _ => "nhan-xam",
    };
}

<header class="trang-dau trang-dau-hang">
    <div>
        <h1>Phiếu chuyển kho</h1>
        <p class="mota">Chuyển hàng giữa hai kho: lập phiếu → quản lý kho duyệt (giữ hàng) → kho đi quét mã gửi đi → kho đến quét mã nhận → xử lý chênh lệch nếu nhận thiếu.</p>
    </div>
    @if (duocTao) { <a class="btn btn-primary" asp-action="Tao">Lập phiếu chuyển</a> }
</header>

@if (TempData["ThongBao"] is string tb) { <div class="alert alert-success" role="status">@tb</div> }
@if (TempData["Loi"] is string loi) { <div class="alert alert-danger" role="alert">@loi</div> }

<section class="luoi-kpi mb-3" aria-label="Hàng đang vận chuyển và chênh lệch">
    <div class="the-kpi">
        <span class="kpi-nhan">Hàng đang vận chuyển</span>
        <strong class="kpi-so so-bang @(dangTrenDuong > 0 ? "kpi-vang" : "")">@dangTrenDuong.ToString("N0")</strong>
        <span class="kpi-phu">đơn vị, thuộc @soPhieuTrenDuong phiếu chưa nhận xong; không tính vào tồn kho nào</span>
    </div>
    <div class="the-kpi">
        <span class="kpi-nhan">Chênh lệch chờ xử lý</span>
        <strong class="kpi-so so-bang @(chenhLechCho > 0 ? "kpi-vang" : "")">@chenhLechCho.ToString("N0")</strong>
        <span class="kpi-phu">đơn vị nhận thiếu, chờ quản lý kho chọn nhập tại kho đến hoặc trả về kho đi</span>
    </div>
</section>

<form method="get" asp-action="Index" class="mb-3 row g-2 align-items-end">
    <div class="col-md-3">
        <label for="loQ" class="form-label">Số phiếu</label>
        <input id="loQ" name="q" class="form-control" value="@q" placeholder="VD: CK000012" maxlength="20" />
    </div>
    <div class="col-md-2">
        <label for="loTu" class="form-label">Từ ngày</label>
        <input id="loTu" name="tuNgay" type="date" class="form-control" value="@tuNgay?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-2">
        <label for="loDen" class="form-label">Đến ngày</label>
        <input id="loDen" name="denNgay" type="date" class="form-control" value="@denNgay?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-3">
        <label for="loTT" class="form-label">Trạng thái</label>
        <select id="loTT" name="trangThai" class="form-select">
            <option value="">Tất cả</option>
            @foreach (var t in PhieuChuyen.TatCaTrangThai) { <option value="@t" selected="@(trangThai == t)">@t</option> }
        </select>
    </div>
    <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100">Lọc</button></div>
</form>

@if (Model.Count == 0)
{
    <p class="khung-trong">Chưa có phiếu chuyển nào khớp bộ lọc.@(duocTao ? " Bấm \"Lập phiếu chuyển\" để bắt đầu." : "")</p>
}
else
{
    <div class="khung-the bang-cuon">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Số phiếu</th><th scope="col">Thời gian</th><th scope="col">Người vận chuyển</th>
                    <th scope="col">Kho đi → Kho đến</th><th scope="col" class="text-end">Số lượng</th><th scope="col">Diễn giải</th>
                    <th scope="col">Trạng thái</th><th scope="col"><span class="visually-hidden">Thao tác</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><a asp-action="Sua" asp-route-id="@p.MaPC">@p.SoPhieu</a></td>
                        <td class="text-nowrap">@p.ThoiGian.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(p.NguoiVanChuyen ?? "—")</td>
                        <td>@p.KhoXuat?.TenKho → @p.KhoNhap?.TenKho</td>
                        <td class="text-end so-bang">@p.ChiTiet.Sum(d => d.SoLuong).ToString("N0")</td>
                        <td>@(p.DienGiai ?? "—")</td>
                        <td><span class="nhan @Nhan(p.TrangThai)">@p.TrangThai</span></td>
                        <td class="text-nowrap text-end">
                            @if (p.TrangThai == PhieuChuyen.DaDuyet) { <a class="btn btn-sm btn-outline-primary" asp-action="Xuat" asp-route-id="@p.MaPC">Xuất hàng</a> }
                            @if (p.TrangThai == PhieuChuyen.DangVanChuyen) { <a class="btn btn-sm btn-outline-primary" asp-action="Nhan" asp-route-id="@p.MaPC">Nhận hàng</a> }
                            @if (p.TrangThai == PhieuChuyen.NhanMotPhan) { <a class="btn btn-sm btn-outline-warning" asp-action="Sua" asp-route-id="@p.MaPC">Xử lý chênh lệch</a> }
                            @if (p.HuyDuoc && duocHuy)
                            {
                                <form method="post" asp-action="Huy" asp-route-id="@p.MaPC" asp-route-quayLai="ds" class="d-inline"
                                      onsubmit="return confirm('Hủy phiếu @p.SoPhieu?@(p.TrangThai == PhieuChuyen.DaDuyet ? " Hàng đang giữ ở kho đi sẽ được trả lại." : "") Không hoàn tác được.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hủy</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
