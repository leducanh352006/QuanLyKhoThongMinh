@using QuanLyKho.Web.Areas.DieuChuyen.Controllers
@using QuanLyKho.Web.Areas.DieuChuyen.Models
@using QuanLyKho.Web.Models
@model (PhieuChuyen Phieu, List<DongHienThi> Dong)
@{
    var p = Model.Phieu;
    var tuyChonQuet = new QuetMaOptions("oQuet", "Quét mã ô, mã lô hoặc mã vạch hàng", "Quét theo thứ tự: ô, lô, mã vạch");
    ViewData["Title"] = $"Xuất hàng {p.SoPhieu}";
}

<header class="trang-dau">
    <h1>Xuất hàng phiếu chuyển @p.SoPhieu</h1>
    <p class="mota">
        <span class="nhan nhan-lam">@p.TrangThai</span>
        @p.KhoXuat?.TenKho → @p.KhoNhap?.TenKho. Quét đúng ô, lô và mã vạch của dòng đang chờ (dòng trên cùng). Quét đủ mọi dòng thì bấm Xác nhận xuất.
    </p>
</header>

@if (TempData["ThongBao"] is string tb) { <div class="alert alert-success" role="status">@tb</div> }
@if (TempData["Loi"] is string loi) { <div class="alert alert-danger" role="alert">@loi</div> }

<partial name="_QuetMa" model="tuyChonQuet" />

<form method="post" asp-action="Xuat" asp-route-id="@p.MaPC" id="formXuat" class="mt-3">
    <div class="d-grid gap-3" id="dsDong">
        @foreach (var d in Model.Dong)
        {
            <div class="card dong-chuyen" data-ma-o="@d.MaVachOXuat" data-ma-lo="@d.MaVachLo" data-ma-bt="@d.MaVachBT">
                <div class="card-body">
                    <h2 class="h6 mb-1">@d.TenHang</h2>
                    <p class="mb-2 text-body-secondary">
                        Lấy ở <strong>@d.TenOXuat</strong> · lô @d.MaVachLo @(d.HanDung is null ? "" : $"(hạn {d.HanDung})") · số lượng <strong>@d.SoLuong</strong>
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="nhan nhan-chu-y" data-slot="o">Chưa quét ô</span>
                        <span class="nhan nhan-chu-y" data-slot="lo">Chưa quét lô</span>
                        <span class="nhan nhan-chu-y" data-slot="bt">Chưa quét mã vạch</span>
                    </div>
                    <input type="hidden" name="maCTC" value="@d.MaCTC" />
                    <input type="hidden" class="f-o" name="maVachO" />
                    <input type="hidden" class="f-lo" name="maVachLo" />
                    <input type="hidden" class="f-bt" name="maVachBT" />
                </div>
            </div>
        }
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <button type="submit" class="btn btn-success btn-lg" id="nutXuat" disabled
                onclick="return confirm('Xác nhận xuất? Tồn kho xuất sẽ giảm ngay, hàng chuyển sang đang trên đường.');">Xác nhận xuất</button>
        <a class="btn btn-outline-secondary" asp-action="Sua" asp-route-id="@p.MaPC">Quay lại phiếu</a>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var the = Array.prototype.slice.call(document.querySelectorAll('.dong-chuyen'));
            var nut = document.getElementById('nutXuat');
            var oThongBao = document.querySelector('[data-quet-ma-thongbao]');
            function bao(t) { setTimeout(function () { oThongBao.textContent = t; }, 0); }   // sau thông báo mặc định của quet-ma.js
            var ten = { o: 'ô', lo: 'lô', bt: 'mã vạch' };
            function buocCon(d) { return !d.querySelector('.f-o').value ? 'o' : !d.querySelector('.f-lo').value ? 'lo' : !d.querySelector('.f-bt').value ? 'bt' : null; }

            document.addEventListener('quetma:them', function (e) {
                var d = the.find(function (x) { return buocCon(x); });
                if (!d) { bao('Đã quét đủ mọi dòng. Bấm Xác nhận xuất.'); return; }
                var buoc = buocCon(d), ma = e.detail.giaTri.toLowerCase();
                var can = d.dataset['ma' + (buoc === 'o' ? 'O' : buoc === 'lo' ? 'Lo' : 'Bt')].toLowerCase();
                if (ma !== can) { bao('Mã "' + e.detail.giaTri + '" không khớp. Hãy quét đúng ' + ten[buoc] + ' của dòng trên cùng còn chờ.'); return; }
                d.querySelector('.f-' + buoc).value = e.detail.giaTri;
                var nhan = d.querySelector('[data-slot="' + buoc + '"]');
                nhan.textContent = 'Đã quét ' + ten[buoc]; nhan.className = 'nhan nhan-tot';
                var conLai = the.filter(function (x) { return buocCon(x); }).length;
                nut.disabled = conLai > 0;
                bao(conLai > 0 ? 'Đúng ' + ten[buoc] + '. Còn ' + conLai + ' dòng chưa quét xong.' : 'Đã quét đủ mọi dòng. Bấm Xác nhận xuất.');
            });
        })();
    </script>
}
