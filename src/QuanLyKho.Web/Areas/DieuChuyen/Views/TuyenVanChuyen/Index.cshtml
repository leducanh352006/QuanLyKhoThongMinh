@model IReadOnlyList<QuanLyKho.Web.Areas.DieuChuyen.Services.TuyenVanChuyenDong>

<header class="trang-dau d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h1>Tuyến vận chuyển</h1>
        <p class="mota">Đơn giá vận chuyển và phí cố định mỗi chuyến giữa từng cặp kho — tham số đầu vào cho gợi ý G4.</p>
    </div>
    <a class="btn btn-primary" asp-action="Them">Thêm tuyến vận chuyển</a>
</header>

@if (TempData["ThongBao"] is string tb) { <div class="alert alert-success" role="status">@tb</div> }
@if (TempData["Loi"] is string loi) { <div class="alert alert-danger" role="alert">@loi</div> }

<div class="bang-cuon">
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Kho xuất</th>
                <th scope="col">Kho nhập</th>
                <th scope="col" class="text-end">Đơn giá vận chuyển</th>
                <th scope="col" class="text-end">Phí mỗi chuyến</th>
                <th scope="col"><span class="visually-hidden">Thao tác</span></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted">Chưa có tuyến vận chuyển nào.</td></tr>
            }
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.TenKhoXuat</td>
                    <td>@t.TenKhoNhap</td>
                    <td class="text-end">@t.DonGiaVC.ToString("N0") đ</td>
                    <td class="text-end">@t.PhiChuyen.ToString("N0") đ</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Sua" asp-route-maKhoXuat="@t.MaKhoXuat" asp-route-maKhoNhap="@t.MaKhoNhap">Sửa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
