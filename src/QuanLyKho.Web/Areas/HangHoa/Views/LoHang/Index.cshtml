@model IReadOnlyList<QuanLyKho.Web.Areas.HangHoa.Services.LoHangDong>
@using Microsoft.AspNetCore.Mvc.Rendering

<header class="trang-dau">
    <h1>Lô hàng</h1>
    <p class="mota">Danh sách lô và hạn dùng của biến thể <strong>@ViewData["ThuocTinh"]</strong> (@ViewData["TenSP"]).</p>
</header>

<form method="get" asp-action="Index" class="mb-3 d-flex flex-wrap align-items-end gap-2">
    <div>
        <label for="chonSanPham" class="form-label">Sản phẩm</label>
        <select id="chonSanPham" name="maSP" class="form-select" onchange="this.form.submit()"
                asp-items="@((IEnumerable<SelectListItem>)ViewData["DanhSachSanPham"]!)"></select>
    </div>
    <div>
        <label for="chonBienThe" class="form-label">Biến thể</label>
        <select id="chonBienThe" name="maBT" class="form-select" onchange="this.form.submit()"
                asp-items="@((IEnumerable<SelectListItem>)ViewData["DanhSachBienThe"]!)"></select>
    </div>
    <noscript><button type="submit" class="btn btn-outline-secondary">Xem</button></noscript>
</form>

@if (Model.Count == 0)
{
    <div class="khung-trong">
        <h2>Biến thể chưa có lô nào</h2>
        <p>Lô được tạo khi nhóm Nhập kho tiếp nhận hàng.</p>
    </div>
}
else
{
    <div class="bang-cuon">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Mã lô</th>
                    <th scope="col">Hạn dùng</th>
                    <th scope="col"><span class="visually-hidden">Trạng thái</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td>@l.MaVachLo</td>
                        <td>@(l.HanDung is DateOnly h ? h.ToString("dd/MM/yyyy") : "—")</td>
                        <td>
                            @if (l.DaHetHan)
                            {
                                <span class="badge text-bg-danger">Đã hết hạn</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
