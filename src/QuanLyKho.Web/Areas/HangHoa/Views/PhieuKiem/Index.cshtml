@using QuanLyKho.Web.Areas.HangHoa.Models
@model List<PhieuKiem>
@{
    ViewData["Title"] = "Phiếu kiểm";
}

<header class="trang-dau d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h1>Phiếu kiểm</h1>
        <p class="mota">Tạo phiếu là bắt đầu kiểm ngay: ô liên quan bị khóa và tồn hệ thống được chụp lại. Hiện 200 phiếu mới nhất.</p>
    </div>
    <a class="btn btn-primary" asp-action="Tao">Tạo phiếu kiểm</a>
</header>

@if (Model.Count == 0)
{
    <p class="khung-trong">Chưa có phiếu kiểm nào. Bấm "Tạo phiếu kiểm" để lập phiếu đầu tiên.</p>
}
else
{
    <div class="bang-cuon">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">Số phiếu</th><th scope="col">Loại</th><th scope="col">Thời gian bắt đầu</th><th scope="col">Kho</th>
                    <th scope="col" class="text-end">Số dòng</th><th scope="col" class="text-end">Người tham gia</th><th scope="col">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><a asp-action="Xem" asp-route-id="@p.MaPK">@p.SoPhieu</a></td>
                        <td>@p.LoaiKiemKe</td>
                        <td>@p.ThoiGianBatDau.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(p.Kho?.TenKho)</td>
                        <td class="text-end">@p.ChiTiet.Count</td>
                        <td class="text-end">@p.ThamGia.Count</td>
                        <td><span class="nhan @(p.TrangThai == PhieuKiem.HoanTat ? "nhan-tot" : "nhan-chu-y")">@p.TrangThai</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
