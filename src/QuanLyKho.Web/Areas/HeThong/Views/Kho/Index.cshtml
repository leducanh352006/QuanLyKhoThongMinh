@model IReadOnlyList<QuanLyKho.Web.Areas.HeThong.Services.KhoDong>
@using QuanLyKho.Web.Contracts
@{
    var laQuanTri = User.IsInRole(VaiTroTen.QuanTriVien);
}

<header class="trang-dau d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h1>Kho</h1>
        <p class="mota">Danh sách kho. Thêm kho sẽ tự tạo kèm một khu tiếp nhận.</p>
    </div>
    @if (laQuanTri)
    {
        <a class="btn btn-primary" asp-action="Them">Thêm kho</a>
    }
</header>

@if (TempData["ThongBao"] is string tb)
{
    <div class="alert alert-success" role="status">@tb</div>
}
@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-danger" role="alert">@loi</div>
}

<div class="bang-cuon">
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Tên kho</th>
                <th scope="col">Loại</th>
                <th scope="col">Quản lý</th>
                <th scope="col">Thời gian chờ (ngày)</th>
                <th scope="col">Trạng thái</th>
                <th scope="col"><span class="visually-hidden">Thao tác</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var k in Model)
            {
                <tr>
                    <td>@k.TenKho</td>
                    <td>@k.LoaiKho</td>
                    <td>@k.TenQuanLy</td>
                    <td>@k.ThoiGianCho</td>
                    <td>
                        @if (k.DangHoatDong)
                        {
                            <span class="nhan nhan-tot">Hoạt động</span>
                        }
                        else
                        {
                            <span class="nhan nhan-loi">Ngừng hoạt động</span>
                        }
                    </td>
                    <td class="text-nowrap text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="ViTri" asp-action="Index" asp-route-maKho="@k.MaKho">Vị trí</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Sua" asp-route-id="@k.MaKho">Sửa</a>
                        @if (laQuanTri)
                        {
                            @if (k.DangHoatDong)
                            {
                                <form method="post" asp-action="Ngung" asp-route-id="@k.MaKho" class="d-inline"
                                      onsubmit="return confirm('Ngừng hoạt động kho @k.TenKho?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Ngừng hoạt động</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-action="MoLai" asp-route-id="@k.MaKho" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Mở lại</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
