@model QuanLyKho.Web.Areas.HeThong.Controllers.HeThongTongQuan

<header class="trang-dau">
    <h1>Hệ thống</h1>
    <p class="mota">Người dùng, phân quyền, kho, vị trí và tồn kho.</p>
</header>

<section aria-labelledby="tieuDeSoLieu">
    <h2 id="tieuDeSoLieu" class="h5">Tình trạng</h2>
    <dl class="trang-thai">
        <dt>Kho</dt>
        <dd>@Model.SoKhoHoatDong kho đang hoạt động trên tổng @Model.SoKho kho.</dd>
        <dt>Sổ cái tồn kho</dt>
        <dd>
            @if (Model.LoiDoiChieu is string loi)
            {
                <span class="nhan nhan-chu-y">Chưa đối chiếu</span> <span class="trang-thai-chu-thich">@loi</span>
            }
            else if (Model.SoChenhLechSoCai == 0)
            {
                <span class="nhan nhan-tot">Khớp</span> <span class="trang-thai-chu-thich">Tổng sổ cái bằng tồn kho ở mọi lô, mọi ô.</span>
            }
            else
            {
                <span class="nhan nhan-loi">Lệch</span> <span class="trang-thai-chu-thich">@Model.SoChenhLechSoCai dòng tồn không khớp sổ cái; cần kiểm tra.</span>
            }
        </dd>
    </dl>
</section>

<section class="mt-4" aria-labelledby="tieuDeChucNang">
    <h2 id="tieuDeChucNang" class="h5">Chức năng</h2>
    <ul class="danh-sach-viec">
        @foreach (var m in Model.ChucNang)
        {
            <li>
                <a asp-area="@m.Area" asp-controller="@m.Controller" asp-action="@m.Action">
                    <span class="viec-ten">@m.Ten</span>
                    <span class="viec-mota">@m.MoTa</span>
                </a>
            </li>
        }
    </ul>
</section>
