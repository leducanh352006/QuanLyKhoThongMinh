@model QuanLyKho.Web.Areas.HeThong.Services.ViTriTrangViewModel
@using QuanLyKho.Web.Areas.HeThong.Services
@using QuanLyKho.Web.Contracts
@{
    var duocSua = User.IsInRole(VaiTroTen.QuanTriVien) || User.IsInRole(VaiTroTen.QuanLyKho);
    var maKho = Model.MaKho;
    var xemCay = Model.CheDoXem == "cay";
}

<header class="trang-dau trang-dau-hang">
    <div>
        <h1>Sơ đồ vị trí &amp; Sức chứa kho</h1>
        <p class="mota">
            Trực quan hóa cấu trúc kệ – ô lưu trữ của <strong>@Model.TenKho</strong>, theo dõi mức lấp đầy thể tích, tải trọng và kiểm tra lọt lòng kích thước 3 chiều (Dài × Rộng × Cao).
        </p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="che-do-xem" role="tablist" aria-label="Chế độ hiển thị vị trí">
            <a class="che-do-nut @(!xemCay ? "dang-chon" : "")"
               id="tabSoDo" role="tab" aria-selected="@(!xemCay ? "true" : "false")" aria-controls="khungSoDo"
               asp-action="Index" asp-route-maKho="@maKho" asp-route-maBTThu="@Model.BienTheDangThu?.MaBT" asp-route-soLuongThu="@Model.SoLuongDangThu" asp-route-cheDo="sodo"
               data-che-do="sodo">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                <span>Sơ đồ trực quan</span>
            </a>
            <a class="che-do-nut @(xemCay ? "dang-chon" : "")"
               id="tabCay" role="tab" aria-selected="@(xemCay ? "true" : "false")" aria-controls="khungCay"
               asp-action="Index" asp-route-maKho="@maKho" asp-route-maBTThu="@Model.BienTheDangThu?.MaBT" asp-route-soLuongThu="@Model.SoLuongDangThu" asp-route-cheDo="cay"
               data-che-do="cay">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                <span>Cây phân cấp</span>
            </a>
        </div>
        @if (duocSua)
        {
            <a class="btn btn-primary" asp-action="Them" asp-route-maKho="@maKho">Thêm vị trí gốc</a>
        }
    </div>
</header>

@if (TempData["ThongBao"] is string tb)
{
    <div class="alert alert-success" role="status">@tb</div>
}
@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-danger" role="alert">@loi</div>
}

<!-- Thanh chọn kho + Kiểm tra nhanh vừa ô 3D -->
<section class="khung-the mb-3" aria-label="Bộ lọc kho và kiểm tra nhanh sức chứa 3 chiều">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-3">
            <form method="get" asp-action="Index">
                <input type="hidden" id="inputCheDoKho" name="cheDo" value="@Model.CheDoXem" />
                @if (Model.BienTheDangThu is not null)
                {
                    <input type="hidden" name="maBTThu" value="@Model.BienTheDangThu.MaBT" />
                    <input type="hidden" name="soLuongThu" value="@Model.SoLuongDangThu" />
                }
                <label for="chonKho" class="form-label fw-semibold mb-1">Kho đang xem</label>
                <select id="chonKho" name="maKho" class="form-select" onchange="this.form.submit()"
                        asp-items="@((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["DanhSachKho"]!)"></select>
                <noscript><button type="submit" class="btn btn-sm btn-outline-secondary mt-1">Chuyển kho</button></noscript>
            </form>
        </div>

        <div class="col-12 col-md-9">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <input type="hidden" name="maKho" value="@maKho" />
                <input type="hidden" name="cheDo" value="sodo" />
                <div class="col-12 col-sm-6 col-lg-7">
                    <label for="chonBTThu" class="form-label fw-semibold mb-1">
                        Kiểm tra nhanh hàng vừa ô (Dài × Rộng × Cao &amp; Tải trọng)
                    </label>
                    <select id="chonBTThu" name="maBTThu" class="form-select" required>
                        <option value="">-- Chọn biến thể hàng hóa để ướm thử lên sơ đồ --</option>
                        @foreach (var bt in Model.DanhSachBienThe)
                        {
                            <option value="@bt.MaBT" selected="@(Model.BienTheDangThu?.MaBT == bt.MaBT ? "selected" : null)">
                                @bt.TenHienThi (@bt.KichThuocText)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-6 col-sm-3 col-lg-2">
                    <label for="soLuongThu" class="form-label fw-semibold mb-1">Số lượng</label>
                    <input id="soLuongThu" name="soLuongThu" type="number" min="1" max="100000"
                           value="@(Model.SoLuongDangThu ?? 10)" class="form-control so-bang" />
                </div>
                <div class="col-6 col-sm-3 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">Kiểm tra</button>
                    @if (Model.BienTheDangThu is not null)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-maKho="@maKho" title="Xóa bộ kiểm tra">Bỏ lọc</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (Model.BienTheDangThu is not null && Model.SoLuongDangThu is int slDangThu)
    {
        <div class="ket-qua-thu-banner @(Model.SoODuChoThu > 0 ? "thu-tot" : "thu-canh-bao") mt-3" role="status">
            <div>
                <strong>Kết quả ướm thử @slDangThu × @Model.BienTheDangThu.TenHienThi</strong>
                <span class="text-muted ms-1">(@Model.BienTheDangThu.KichThuocText — kiểm xoay hộp 6 hướng <code>sort(d,r,c) ≤ sort(D,R,C)</code>):</span>
                @if (Model.SoODuChoThu > 0)
                {
                    <span>Có <strong>@Model.SoODuChoThu / @Model.TongOLuuTru ô lưu trữ</strong> nhận đủ ngay @slDangThu đơn vị (tổng sức chứa còn nhận thêm của toàn kho: <strong>+@Model.TongSucChuaThemDuocThu</strong> đơn vị).</span>
                }
                else
                {
                    <span>Không có ô đơn lẻ nào nhận trọn @slDangThu đơn vị (tổng kho còn nhận tối đa <strong>+@Model.TongSucChuaThemDuocThu</strong> đơn vị — có thể chia nhiều ô hoặc xem lý do trên từng thẻ ô bên dưới).</span>
                }
            </div>
        </div>
    }
</section>

<!-- Dải 5 chỉ số KPI -->
<section class="luoi-kpi mb-4" aria-label="Thống kê nhanh vị trí kho">
    <div class="the-kpi">
        <span class="kpi-nhan">Tổng ô lưu trữ</span>
        <strong class="kpi-so so-bang">@Model.TongOLuuTru</strong>
        <span class="kpi-phu">Tổng số ô cấp lưu trữ</span>
    </div>
    <div class="the-kpi">
        <span class="kpi-nhan">Ô trống (0%)</span>
        <strong class="kpi-so so-bang kpi-xanh">@Model.OTrong</strong>
        <span class="kpi-phu">Sẵn sàng xếp lô mới</span>
    </div>
    <div class="the-kpi">
        <span class="kpi-nhan">Đang chứa hàng (1–79%)</span>
        <strong class="kpi-so so-bang kpi-lam">@Model.OConCho</strong>
        <span class="kpi-phu">Còn dung tích ghép hàng</span>
    </div>
    <div class="the-kpi">
        <span class="kpi-nhan">Sắp đầy (≥ 80%)</span>
        <strong class="kpi-so so-bang kpi-vang">@Model.OSapDay</strong>
        <span class="kpi-phu">Theo thể tích hoặc tải trọng</span>
    </div>
    <div class="the-kpi">
        <span class="kpi-nhan">Khóa / Ngừng / Tiếp nhận</span>
        <strong class="kpi-so so-bang">@Model.OKhoaHoacNgung / @Model.KhuTiepNhan.Count</strong>
        <span class="kpi-phu">Ô tạm dừng &amp; cửa nhận</span>
    </div>
</section>

@if (Model.CayGoc.Count == 0)
{
    <div class="khung-trong">
        <h2>Kho chưa có vị trí nào</h2>
        <p>Bấm "Thêm vị trí gốc" để bắt đầu dựng sơ đồ, ví dụ một Dãy lưu trữ hoặc Khu tiếp nhận.</p>
    </div>
}
else
{
    <!-- CHẾ ĐỘ 1: SƠ ĐỒ TRỰC QUAN -->
    <div id="khungSoDo" role="tabpanel" aria-labelledby="tabSoDo" class="@(xemCay ? "d-none" : "")">
        @if (Model.KhuTiepNhan.Count > 0)
        {
            <section class="mb-4" aria-label="Khu tiếp nhận hàng nhập">
                @foreach (var tn in Model.KhuTiepNhan)
                {
                    <div class="khung-tiep-nhan">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="nhan nhan-lam">Khu tiếp nhận</span>
                                    <strong>@tn.Nut.TenViTri</strong>
                                    @if (tn.Nut.MaVachO is not null)
                                    {
                                        <code class="ma-vach-o">@tn.Nut.MaVachO</code>
                                    }
                                    @if (!tn.Nut.DangHoatDong)
                                    {
                                        <span class="nhan nhan-loi">Ngừng hoạt động</span>
                                    }
                                </div>
                                <div class="small text-muted mt-1">
                                    Không giới hạn kích thước · Hàng mới nhập chờ kiểm / chờ xếp nằm tại đây (đang có <strong class="so-bang">@tn.SoLuongTon</strong> đơn vị tại cửa nhận).
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @if (duocSua)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Sua" asp-route-id="@tn.Nut.MaViTri">Sửa</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="LichSuTon" asp-action="Index" asp-route-MaViTri="@tn.Nut.MaViTri">Lịch sử tồn</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        @if (Model.KhuLuuTru.Count == 0)
        {
            <div class="khung-trong">
                <h2>Chưa có khu/kệ lưu trữ</h2>
                <p>Kho hiện mới có Khu tiếp nhận. Hãy thêm Dãy, Kệ và các Ô lưu trữ để xếp hàng.</p>
            </div>
        }
        else
        {
            <div class="d-grid gap-4">
                @foreach (var khu in Model.KhuLuuTru)
                {
                    <section class="khung-khu @(!khu.DangHoatDong ? "khung-ngung" : "")">
                        <div class="khung-khu-dau">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="cap-huy-hieu">@khu.CapKhu</span>
                                <h2 class="h5 mb-0 fw-bold">@khu.TenKhu</h2>
                                @if (!string.IsNullOrWhiteSpace(khu.DuongDan))
                                {
                                    <span class="text-muted small">@khu.DuongDan</span>
                                }
                                @if (!khu.DangHoatDong)
                                {
                                    <span class="nhan nhan-loi">Ngừng hoạt động</span>
                                }
                            </div>
                            @if (duocSua && khu.MaKhu is int maKhuCha)
                            {
                                <div class="d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Them" asp-route-maKho="@maKho" asp-route-maViTriCha="@maKhuCha">+ Thêm kệ / vị trí con</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Sua" asp-route-id="@maKhuCha">Sửa</a>
                                </div>
                            }
                        </div>

                        @if (khu.DanhSachKe.Count == 0)
                        {
                            <p class="text-muted small mb-0 mt-2">Nhánh này chưa có kệ hoặc ô lưu trữ nào.</p>
                        }
                        else
                        {
                            <div class="luoi-ke mt-3">
                                @foreach (var ke in khu.DanhSachKe)
                                {
                                    <div class="khung-ke">
                                        <div class="khung-ke-dau">
                                            <div>
                                                <strong class="ten-ke">@ke.TenKe</strong>
                                                <span class="text-muted small ms-1">(@ke.DanhSachO.Count ô)</span>
                                            </div>
                                            @if (duocSua && ke.MaKe is int maKeCha)
                                            {
                                                <div class="d-flex gap-1">
                                                    <a class="btn btn-sm btn-link px-1 py-0 text-decoration-none" asp-action="Them" asp-route-maKho="@maKho" asp-route-maViTriCha="@maKeCha">+ Thêm ô</a>
                                                    <a class="btn btn-sm btn-link px-1 py-0 text-secondary text-decoration-none" asp-action="Sua" asp-route-id="@maKeCha">Sửa</a>
                                                </div>
                                            }
                                        </div>

                                        @if (ke.DanhSachO.Count == 0)
                                        {
                                            <div class="text-muted small py-2">Kệ chưa có ô nào.</div>
                                        }
                                        else
                                        {
                                            <div class="luoi-o">
                                                @foreach (var o in ke.DanhSachO)
                                                {
                                                    var lopTrangThai = o.TrangThaiHienThi switch
                                                    {
                                                        TrangThaiHienThiO.DangKhoa => "the-o-khoa",
                                                        TrangThaiHienThiO.NgungHoatDong => "the-o-ngung",
                                                        TrangThaiHienThiO.SapDay => "the-o-sap-day",
                                                        TrangThaiHienThiO.ConCho => "the-o-con-cho",
                                                        _ => "the-o-trong"
                                                    };
                                                    var (nhanTrangThai, lopNhan) = o.TrangThaiHienThi switch
                                                    {
                                                        TrangThaiHienThiO.DangKhoa => ("Đang khóa KK", "nhan-loi"),
                                                        TrangThaiHienThiO.NgungHoatDong => ("Ngừng HĐ", "nhan-xam"),
                                                        TrangThaiHienThiO.SapDay => ("Sắp đầy", "nhan-chu-y"),
                                                        TrangThaiHienThiO.ConCho => ("Còn chỗ", "nhan-lam"),
                                                        _ => ("Ô trống", "nhan-tot")
                                                    };

                                                    if (o.ThuKichThuoc is not null)
                                                    {
                                                        lopTrangThai = o.ThuKichThuoc.Loai switch
                                                        {
                                                            LoaiKetQuaThuO.DuCho => "the-o-thu-ok",
                                                            LoaiKetQuaThuO.QuaKichThuoc3D => "the-o-thu-loi",
                                                            LoaiKetQuaThuO.BiChan => "the-o-thu-loi",
                                                            _ => "the-o-thu-canh-bao"
                                                        };
                                                    }

                                                    <article class="the-o @lopTrangThai">
                                                        <div>
                                                            <div class="d-flex align-items-start justify-content-between gap-1">
                                                                <strong class="the-o-ten">@o.Nut.TenViTri</strong>
                                                                <span class="nhan @lopNhan">@nhanTrangThai</span>
                                                            </div>
                                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mt-1">
                                                                @if (o.Nut.MaVachO is not null)
                                                                {
                                                                    <code class="ma-vach-o">@o.Nut.MaVachO</code>
                                                                }
                                                                @if (o.Nut.Dai is not null)
                                                                {
                                                                    <span class="the-o-kt so-bang">@o.Nut.Dai?.ToString("0.##")×@o.Nut.Rong?.ToString("0.##")×@o.Nut.Cao?.ToString("0.##") cm · @o.Nut.KhoiLuongToiDa?.ToString("0.##") kg</span>
                                                                }
                                                            </div>
                                                        </div>

                                                        <div class="the-o-thanh">
                                                            <div class="d-flex justify-content-between small so-bang">
                                                                <span class="text-muted">Thể tích</span>
                                                                <span class="fw-semibold">@o.PhanTramTheTich%</span>
                                                            </div>
                                                            <div class="thanh-lap-day" role="progressbar" aria-label="Phần trăm thể tích @o.Nut.TenViTri" aria-valuenow="@o.PhanTramTheTich" aria-valuemin="0" aria-valuemax="100">
                                                                <div class="thanh-lap-day-ruot @(o.PhanTramTheTich >= 80 ? "muc-cao" : "muc-vua")" style="width: @(o.PhanTramTheTich)%"></div>
                                                            </div>

                                                            <div class="d-flex justify-content-between small so-bang mt-1">
                                                                <span class="text-muted">Tải trọng</span>
                                                                <span class="fw-semibold">@o.PhanTramKhoiLuong%</span>
                                                            </div>
                                                            <div class="thanh-lap-day" role="progressbar" aria-label="Phần trăm khối lượng @o.Nut.TenViTri" aria-valuenow="@o.PhanTramKhoiLuong" aria-valuemin="0" aria-valuemax="100">
                                                                <div class="thanh-lap-day-ruot @(o.PhanTramKhoiLuong >= 80 ? "muc-cao" : "muc-vua")" style="width: @(o.PhanTramKhoiLuong)%"></div>
                                                            </div>
                                                        </div>

                                                        <div class="the-o-ton small so-bang">
                                                            <span>Tồn: <strong>@o.SoLuongTon</strong></span>
                                                            @if (o.SoLuongGiu > 0)
                                                            {
                                                                <span class="text-warning-emphasis">· Giữ: <strong>@o.SoLuongGiu</strong></span>
                                                            }
                                                            @if (o.SoLuongChoXep > 0)
                                                            {
                                                                <span class="text-primary">· Chờ xếp: <strong>@o.SoLuongChoXep</strong></span>
                                                            }
                                                        </div>

                                                        @if (o.ThuKichThuoc is not null)
                                                        {
                                                            var lopKetQuaThu = o.ThuKichThuoc.Loai switch
                                                            {
                                                                LoaiKetQuaThuO.DuCho => "ket-qua-o-ok",
                                                                LoaiKetQuaThuO.QuaKichThuoc3D => "ket-qua-o-loi",
                                                                LoaiKetQuaThuO.BiChan => "ket-qua-o-loi",
                                                                _ => "ket-qua-o-canh-bao"
                                                            };
                                                            <div class="ket-qua-o @lopKetQuaThu" title="@o.ThuKichThuoc.ChiTiet">
                                                                <strong>@o.ThuKichThuoc.NhanNgan</strong>
                                                                <div class="ket-qua-o-phu">@o.ThuKichThuoc.ChiTiet</div>
                                                            </div>
                                                        }

                                                        @if (duocSua)
                                                        {
                                                            <div class="the-o-hanh-dong">
                                                                <a class="nut-nho" asp-controller="LichSuTon" asp-action="Index" asp-route-MaViTri="@o.Nut.MaViTri">Lịch sử tồn</a>
                                                                <a class="nut-nho" asp-action="Sua" asp-route-id="@o.Nut.MaViTri">Sửa</a>
                                                                @if (o.Nut.DangKhoa)
                                                                {
                                                                    <form method="post" asp-action="MoKhoaKiemKe" asp-route-id="@o.Nut.MaViTri" asp-route-maKho="@maKho" class="d-inline">
                                                                        <button type="submit" class="nut-nho nut-nho-xanh">Mở khóa KK</button>
                                                                    </form>
                                                                }
                                                                else if (o.Nut.DangHoatDong)
                                                                {
                                                                    <form method="post" asp-action="KhoaKiemKe" asp-route-id="@o.Nut.MaViTri" asp-route-maKho="@maKho" class="d-inline"
                                                                          data-confirm="Khóa ô '@o.Nut.TenViTri' để kiểm kê?"
                                                                          onsubmit="return confirm(this.dataset.confirm);">
                                                                        <button type="submit" class="nut-nho nut-nho-vang">Khóa KK</button>
                                                                    </form>
                                                                }
                                                            </div>
                                                        }
                                                    </article>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        }
    </div>

    <!-- CHẾ ĐỘ 2: CÂY PHÂN CẤP CHI TIẾT (GIỮ ĐẦY ĐỦ THAO TÁC QUẢN TRỊ 7 CẤP) -->
    <div id="khungCay" role="tabpanel" aria-labelledby="tabCay" class="khung-the @(xemCay ? "" : "d-none")">
        <div class="mb-2 pb-2 border-bottom d-flex justify-content-between align-items-center">
            <strong class="small text-uppercase text-muted">Cây phân cấp đầy đủ (Tòa → Tầng → Phòng → Dãy → Hàng → Kệ → Ô)</strong>
            <span class="small text-muted">Hỗ trợ thêm/sửa/khóa mềm/xóa từng nút ở mọi cấp</span>
        </div>
        <ul class="nut-cay-goc">
            @foreach (var nut in Model.CayGoc)
            {
                @await Html.PartialAsync("_NutCay", nut)
            }
        </ul>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const tabSoDo = document.getElementById("tabSoDo");
            const tabCay = document.getElementById("tabCay");
            const khungSoDo = document.getElementById("khungSoDo");
            const khungCay = document.getElementById("khungCay");
            const inputCheDoKho = document.getElementById("inputCheDoKho");
            if (!tabSoDo || !tabCay || !khungSoDo || !khungCay) return;

            function batCheDo(cheDo, e) {
                if (e) e.preventDefault();
                const laCay = cheDo === "cay";
                khungSoDo.classList.toggle("d-none", laCay);
                khungCay.classList.toggle("d-none", !laCay);
                tabSoDo.classList.toggle("dang-chon", !laCay);
                tabCay.classList.toggle("dang-chon", laCay);
                tabSoDo.setAttribute("aria-selected", String(!laCay));
                tabCay.setAttribute("aria-selected", String(laCay));
                if (inputCheDoKho) inputCheDoKho.value = cheDo;
                const url = new URL(window.location.href);
                url.searchParams.set("cheDo", cheDo);
                window.history.replaceState({}, "", url);
            }

            tabSoDo.addEventListener("click", e => batCheDo("sodo", e));
            tabCay.addEventListener("click", e => batCheDo("cay", e));
        })();
    </script>
}
