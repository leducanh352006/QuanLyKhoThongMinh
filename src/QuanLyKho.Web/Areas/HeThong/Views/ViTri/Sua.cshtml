@model QuanLyKho.Web.Areas.HeThong.Models.ViTriSuaViewModel

<header class="trang-dau">
    <h1>Sửa vị trí</h1>
    <p class="mota">@Model.DuongDanDayDu</p>
</header>

<form method="post" asp-action="Sua" class="khung-form" novalidate>
    <input type="hidden" asp-for="MaViTri" />
    <input type="hidden" asp-for="MaKho" />
    <input type="hidden" asp-for="CapViTri" />
    <input type="hidden" asp-for="DuongDanDayDu" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert" asp-validation-summary="All"></div>
    }

    <div class="mb-3">
        <label asp-for="TenViTri" class="form-label"></label>
        <input asp-for="TenViTri" class="form-control" />
    </div>

    @if (Model.CapViTri == "Ô")
    {
        <div class="mb-3">
            <label asp-for="LoaiViTri" class="form-label"></label>
            <select asp-for="LoaiViTri" class="form-select" asp-items="@((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["LoaiViTri"]!)"></select>
        </div>
        <div class="mb-3">
            <label asp-for="MaVachO" class="form-label"></label>
            <input asp-for="MaVachO" class="form-control" />
        </div>
        <div class="row g-2">
            <div class="col-6 col-md-3">
                <label asp-for="Dai" class="form-label"></label>
                <input asp-for="Dai" class="form-control" type="number" step="0.01" min="0" />
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="Rong" class="form-label"></label>
                <input asp-for="Rong" class="form-control" type="number" step="0.01" min="0" />
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="Cao" class="form-label"></label>
                <input asp-for="Cao" class="form-control" type="number" step="0.01" min="0" />
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="KhoiLuongToiDa" class="form-label"></label>
                <input asp-for="KhoiLuongToiDa" class="form-control" type="number" step="0.001" min="0" />
            </div>
        </div>
        <div class="form-text">Để trống dài, rộng, cao, khối lượng tối đa nếu là ô Tiếp nhận (không giới hạn).</div>
    }
    else
    {
        <p class="text-muted">Cấp '@Model.CapViTri' không có kích thước hay khối lượng.</p>
    }

    <button type="submit" class="btn btn-primary mt-3">Lưu</button>
    <a class="btn btn-outline-secondary mt-3" asp-action="Index" asp-route-maKho="@Model.MaKho">Hủy</a>
</form>
