@using QuanLyKho.Web.Areas.XuatKho.Controllers
@using QuanLyKho.Web.Areas.XuatKho.Models
@using QuanLyKho.Web.Models
@model (PhieuXuat Phieu, List<DongLayHang> Dong)
@{
    var p = Model.Phieu;
    var dong = Model.Dong;
    var chuaXong = dong.Where(d => d.SLThucLay is null).ToList();
    var daXong = dong.Where(d => d.SLThucLay is not null).ToList();
    var tuyChonQuet = new QuetMaOptions("oQuet", "Quét mã ô, mã lô hoặc mã vạch biến thể", "Quét theo thứ tự: ô, lô, mã vạch");
    ViewData["Title"] = $"Lấy hàng {p.SoPhieu}";
}

<header class="trang-dau">
    <h1>Lấy hàng phiếu @p.SoPhieu</h1>
    <p class="mota">
        <span class="nhan @(chuaXong.Count == 0 ? "nhan-tot" : "nhan-chu-y")">@p.TrangThai</span>
        Quét đúng ô, lô và mã vạch của dòng đang chờ (dòng trên cùng) — sai mã nào cũng bị từ chối, không ghi gì.
    </p>
</header>

@if (TempData["ThongBao"] is string tb) { <div class="alert alert-success" role="status">@tb</div> }
@if (TempData["Loi"] is string loi) { <div class="alert alert-danger" role="alert">@loi</div> }

@if (chuaXong.Count > 0)
{
    <partial name="_QuetMa" model="tuyChonQuet" />
}

<h2 class="h5 mt-4">Còn chờ lấy (@chuaXong.Count)</h2>
@if (chuaXong.Count == 0)
{
    <p class="khung-trong">Đã lấy xong mọi dòng của phiếu này.</p>
}
else
{
    <div class="d-grid gap-3" id="dsChoLay">
        @foreach (var d in chuaXong)
        {
            <div class="card dong-lay-hang" data-ma-lh="@d.MaLH" data-ma-o="@d.MaVachO" data-ma-lo="@d.MaVachLo" data-ma-bt="@d.MaVachBT">
                <div class="card-body">
                    <h3 class="h6 mb-1">@d.TenHang</h3>
                    <p class="mb-2 text-body-secondary">
                        Lô @d.MaVachLo @(d.HanDung is null ? "" : $"(hạn {d.HanDung})") · Ô @d.TenO · Cần lấy <strong>@d.SLGiu</strong>
                    </p>
                    <div class="d-flex flex-wrap gap-3 mb-2 slot-trang-thai">
                        <span class="nhan nhan-chu-y" data-slot="o">Chưa quét ô</span>
                        <span class="nhan nhan-chu-y" data-slot="lo">Chưa quét lô</span>
                        <span class="nhan nhan-chu-y" data-slot="bt">Chưa quét mã vạch</span>
                    </div>
                    <form method="post" asp-action="XacNhan" asp-route-id="@p.MaPX" class="form-xac-nhan" hidden>
                        <input type="hidden" name="maLH" value="@d.MaLH" />
                        <input type="hidden" class="f-o" name="maVachO" />
                        <input type="hidden" class="f-lo" name="maVachLo" />
                        <input type="hidden" class="f-bt" name="maVachBT" />
                        <div class="row g-2 align-items-end">
                            <div class="col-6 col-sm-4">
                                <label class="form-label">Số lượng thực lấy</label>
                                <input type="number" class="form-control form-control-lg f-sl" name="slThucLay" min="0" max="@d.SLGiu" value="@d.SLGiu" required />
                            </div>
                            <div class="col-12 col-sm-5 f-lydo-boc" hidden>
                                <label class="form-label">Lý do lệch</label>
                                <input type="text" class="form-control f-lydo" name="lyDoLech" maxlength="255" />
                            </div>
                            <div class="col-6 col-sm-3">
                                <button type="submit" class="btn btn-success btn-lg w-100">Xác nhận</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
}

@if (daXong.Count > 0)
{
    <h2 class="h5 mt-4">Đã xác nhận (@daXong.Count)</h2>
    <div class="bang-cuon">
        <table class="table table-sm align-middle">
            <thead><tr><th scope="col">Hàng</th><th scope="col">Lô</th><th scope="col">Ô</th><th scope="col" class="text-end">Giữ / thực lấy</th><th scope="col">Lý do lệch</th></tr></thead>
            <tbody>
                @foreach (var d in daXong)
                {
                    <tr>
                        <td>@d.TenHang</td>
                        <td>@d.MaVachLo</td>
                        <td>@d.TenO</td>
                        <td class="text-end">@d.SLGiu / @d.SLThucLay</td>
                        <td>@(d.LyDoLech ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<p class="mt-3"><a class="btn btn-outline-secondary" asp-action="Index">Quay lại danh sách</a></p>

@section Scripts {
    <script>
        (function () {
            var the = Array.prototype.slice.call(document.querySelectorAll('.dong-lay-hang'));
            var thongBao = document.querySelector('[data-quet-ma-thongbao]');
            function bao(t) { if (thongBao) { thongBao.textContent = t; } }

            // Chỉ dòng trên cùng (chưa xong) nhận mã quét, đúng thứ tự: ô rồi lô rồi mã vạch.
            document.addEventListener('quetma:them', function (e) {
                var d = the[0];
                if (!d) { return; }
                var ma = e.detail.giaTri.toLowerCase();
                var buoc = !d.querySelector('.f-o').value ? 'o' : !d.querySelector('.f-lo').value ? 'lo' : !d.querySelector('.f-bt').value ? 'bt' : null;
                if (!buoc) { return; }
                var maCan = d.dataset['ma' + (buoc === 'o' ? 'O' : buoc === 'lo' ? 'Lo' : 'Bt')].toLowerCase();
                if (ma !== maCan) { bao('Mã "' + e.detail.giaTri + '" không khớp — hãy quét đúng ' + (buoc === 'o' ? 'ô' : buoc === 'lo' ? 'lô' : 'mã vạch') + ' của dòng trên cùng.'); return; }

                d.querySelector('.f-' + buoc).value = e.detail.giaTri;
                d.querySelector('[data-slot="' + buoc + '"]').textContent = 'Đã quét ' + (buoc === 'o' ? 'ô' : buoc === 'lo' ? 'lô' : 'mã vạch');
                d.querySelector('[data-slot="' + buoc + '"]').className = 'nhan nhan-tot';

                if (d.querySelector('.f-o').value && d.querySelector('.f-lo').value && d.querySelector('.f-bt').value) {
                    var form = d.querySelector('.form-xac-nhan');
                    form.hidden = false;
                    form.querySelector('.f-sl').focus();
                }
            });

            the.forEach(function (d) {
                var sl = d.querySelector('.f-sl'), lyDoBoc = d.querySelector('.f-lydo-boc'), lyDo = d.querySelector('.f-lydo');
                var du = parseInt(sl.max, 10);
                sl.addEventListener('input', function () {
                    var thieu = sl.value !== '' && parseInt(sl.value, 10) !== du;
                    lyDoBoc.hidden = !thieu;
                    lyDo.required = thieu;
                });
            });
        })();
    </script>
}
