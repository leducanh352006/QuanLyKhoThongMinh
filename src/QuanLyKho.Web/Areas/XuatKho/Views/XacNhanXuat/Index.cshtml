@using QuanLyKho.Web.Areas.XuatKho.Models
@model List<PhieuXuat>
@{
    ViewData["Title"] = "Xác nhận xuất";
}

<header class="trang-dau trang-dau-hang">
    <div>
        <h1>Xác nhận xuất</h1>
        <p class="mota">Phiếu Đã đối chiếu (khớp với số thực lấy) — xác nhận để ghi giảm tồn kho thật và hoàn tất phiếu.</p>
    </div>
</header>

@if (TempData["ThongBao"] is string tb) { <div class="alert alert-success" role="status">@tb</div> }
@if (TempData["Loi"] is string loi) { <div class="alert alert-danger" role="alert">@loi</div> }

@if (Model.Count == 0)
{
    <p class="khung-trong">Không có phiếu nào sẵn sàng xác nhận xuất (chưa có phiếu Đã đối chiếu).</p>
}
else
{
    <div class="bang-cuon">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">Số phiếu</th><th scope="col">Loại</th><th scope="col">Thời gian</th><th scope="col">Kho</th>
                    <th scope="col">Đối tượng</th><th scope="col">Trạng thái</th><th scope="col"><span class="visually-hidden">Thao tác</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><a asp-controller="PhieuXuat" asp-action="Sua" asp-route-id="@p.MaPX">@p.SoPhieu</a></td>
                        <td>@p.LoaiPhieu</td>
                        <td class="so-bang">@p.ThoiGian.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(p.Kho?.TenKho)</td>
                        <td>@(p.DoiTuong ?? "—")</td>
                        <td><span class="nhan nhan-lam">@p.TrangThai</span></td>
                        <td class="text-end"><a class="btn btn-sm btn-primary" asp-action="Xem" asp-route-id="@p.MaPX">Xác nhận xuất</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
