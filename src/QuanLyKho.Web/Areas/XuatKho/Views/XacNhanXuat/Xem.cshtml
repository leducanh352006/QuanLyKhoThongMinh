@using QuanLyKho.Web.Areas.XuatKho.Models
@using QuanLyKho.Web.Areas.XuatKho.Services
@model (PhieuXuat Phieu, IReadOnlyList<DongXacNhanXuat> Dong)
@{
    var p = Model.Phieu;
    var dong = Model.Dong;
    ViewData["Title"] = $"Xác nhận xuất phiếu {p.SoPhieu}";
}

<header class="trang-dau trang-dau-hang">
    <div>
        <h1>Xác nhận xuất phiếu @p.SoPhieu</h1>
        <p class="mota">
            <span class="nhan nhan-lam">@p.TrangThai</span> @p.LoaiPhieu
            · Đã đối chiếu khớp với số thực lấy — xác nhận để ghi giảm tồn kho và hoàn tất phiếu.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-controller="PhieuXuat" asp-action="Sua" asp-route-id="@p.MaPX">Xem phiếu</a>
        <a class="btn btn-outline-secondary" asp-area="HeThong" asp-controller="ViTri" asp-action="Index" asp-route-maKho="@p.MaKho">Sơ đồ vị trí kho</a>
    </div>
</header>

@if (TempData["ThongBao"] is string tb) { <div class="alert alert-success" role="status">@tb</div> }
@if (TempData["Loi"] is string loi) { <div class="alert alert-danger" role="alert">@loi</div> }

<section class="khung-the mb-3">
    <p class="mota mb-2">
        Kho @(p.Kho?.TenKho) · Đối tượng @(p.DoiTuong ?? "—")
    </p>
    <div class="bang-cuon">
        <table class="table table-sm align-middle">
            <thead>
                <tr><th scope="col">Hàng</th><th scope="col">Mã lô</th><th scope="col">Ô lấy hàng</th><th scope="col" class="text-end">Số lượng thực xuất</th></tr>
            </thead>
            <tbody>
                @foreach (var d in dong)
                {
                    <tr>
                        <td>@d.TenHang</td>
                        <td>@d.MaVachLo @(d.HanDung is null ? "" : $"(hạn {d.HanDung:dd/MM/yyyy})")</td>
                        <td>@d.TenViTri</td>
                        <td class="text-end so-bang">@d.SoLuong</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><td colspan="3" class="text-end"><strong>Tổng cộng</strong></td><td class="text-end so-bang"><strong>@dong.Sum(x => x.SoLuong)</strong></td></tr>
            </tfoot>
        </table>
    </div>
</section>

<form method="post" asp-action="XacNhan" asp-route-id="@p.MaPX" class="d-flex flex-wrap gap-2 mt-3" id="formXacNhan">
    <button type="submit" class="btn btn-danger btn-lg"
            onclick="return confirm('Xác nhận xuất phiếu @p.SoPhieu? Thao tác này sẽ ghi giảm tồn kho thật theo đúng số đã lấy ở trên — không thể hoàn tác bằng cách bấm lại. Phiếu sẽ bị khóa hoàn toàn (Hoàn tất).');">
        Xác nhận xuất
    </button>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại danh sách</a>
</form>

@await Component.InvokeAsync("DinhKem", new { loai = QuanLyKho.Web.Contracts.LoaiChungTu.XK, maCT = p.MaPX })

@section Scripts {
    <script>
        document.getElementById('formXacNhan').addEventListener('submit', e => setTimeout(() => e.submitter && (e.submitter.disabled = true)));
    </script>
}
