@inject INguoiDungHienTai NguoiDungHienTai
@{
    var nguoiDung = NguoiDungHienTai.Lay();
    var tieuDe = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(tieuDe) ? "" : tieuDe + " - ")Quản lý kho thông minh</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="bo-qua" href="#noiDung">Bỏ qua menu, tới nội dung</a>

    <header class="thanh-tren">
        <button class="btn nut-menu d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#thanhMenu"
                aria-controls="thanhMenu" aria-label="Mở menu">
            <span class="nut-menu-icon" aria-hidden="true"></span><span>Menu</span>
        </button>

        <a class="thuong-hieu" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="thuong-hieu-bieu-tuong" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9.5L12 4l9 5.5v9.5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z" />
                    <path d="M9 20V12h6v8" />
                </svg>
            </span>
            <span>Quản lý kho thông minh</span>
        </a>

        <div class="nguoi-dung">
            @if (nguoiDung is not null)
            {
                <span class="vai-tro-huy-hieu">@nguoiDung.TenVaiTro</span>
                <span class="nguoi-dung-ten d-none d-sm-inline">@nguoiDung.HoTen</span>
                <form method="post" asp-area="HeThong" asp-controller="TaiKhoan" asp-action="DangXuat" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Đăng xuất</button>
                </form>
            }
            else
            {
                <a class="btn btn-sm btn-primary" asp-area="HeThong" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
            }
        </div>
    </header>

    <div class="khung">
        <aside class="thanh-menu offcanvas-lg offcanvas-start" tabindex="-1" id="thanhMenu" aria-label="Menu chính">
            <div class="offcanvas-header d-lg-none border-bottom border-secondary border-opacity-25">
                <span class="offcanvas-title fw-semibold">Điều hướng hệ thống</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#thanhMenu" aria-label="Đóng menu"></button>
            </div>
            <div class="offcanvas-body">
                <vc:menu-vai-tro />
            </div>
        </aside>

        <main id="noiDung" class="noi-dung" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/quet-ma.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
